[Unit]
Description=Uzanet xl2tpd peer provisioning agent
After=xl2tpd.service
Requires=xl2tpd.service

[Service]
Type=simple
EnvironmentFile=/etc/uzanet-vpn-agent/agent.env
ExecStart=/usr/bin/python3 /usr/local/lib/uzanet-vpn-agent/agent.py
Restart=on-failure
RestartSec=2
User=root
Group=root
UMask=0077
RuntimeDirectory=uzanet-vpn-agent
RuntimeDirectoryMode=0770
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/ppp /run/uzanet-vpn-agent /var/lib/uzanet-vpn-agent

[Install]
WantedBy=multi-user.target
