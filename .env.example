# Runtime
ENVIRONMENT=development
SECRET_KEY=replace-with-at-least-32-random-characters
ROUTER_CREDENTIAL_KEY=replace-with-a-fernet-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENABLE_API_DOCS=true
API_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Database
DATABASE_URL=mysql+pymysql://uzanet:replace-me@db/uzanet
MYSQL_DATABASE=uzanet
MYSQL_USER=uzanet
MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-me-too

# Initial operator (remove these after the first successful boot)
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=

# Router control network and same-host xl2tpd provisioning agent.
ROUTER_CONTROL_HOST=
ROUTER_CONTROL_CIDR=10.10.10.0/24
ROUTER_ALLOWED_CIDRS=10.10.10.0/24
ROUTER_CONNECT_TIMEOUT_SECONDS=4
ROUTER_OPERATION_TIMEOUT_SECONDS=10
ONBOARDING_TOKEN_MINUTES=120
VPN_AGENT_SOCKET=/run/uzanet-vpn-agent/agent.sock
VPN_AGENT_SHARED_SECRET=replace-with-the-value-generated-by-vpn-agent-install
VPN_AGENT_TIMEOUT_SECONDS=3

# Public payments
PAYMENT_PROVIDER=mpesa
PAYMENT_PROVIDERS=mpesa,kopokopo
PAYMENT_SESSION_MINUTES=15
PAYMENT_STATUS_TOKEN_MINUTES=30
PUBLIC_PAYMENT_LIMIT=3
PUBLIC_PAYMENT_WINDOW_MINUTES=5
JOB_INTERVAL_SECONDS=60

# Safaricom Daraja
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_BUSINESS_SHORT_CODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_VERIFY_CALLBACK=true

# Kopo Kopo (only required for routers using provider=kopokopo)
KOPOKOPO_BASE_URL=https://sandbox.kopokopo.com
KOPOKOPO_CLIENT_ID=
KOPOKOPO_CLIENT_SECRET=
KOPOKOPO_API_KEY=
KOPOKOPO_TILL_NUMBER=
